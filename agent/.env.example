# ---------------------------------------------------------------
# Desenvolvimento local (uvicorn/debug no host — WSL ou máquina física)
# ---------------------------------------------------------------
# Suba as dependências com docker compose (RabbitMQ, Grafana, Azurite etc.) e
# aponte tudo para localhost, porque nomes tipo rabbitmq/grafana só resolvem
# DENTRO da rede do Compose, não no processo do agent fora do Docker.
#
# GRAFANA_URL=http://127.0.0.1:3000
# RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# BLOB_STORAGE=http://127.0.0.1:10000/devstoreaccount1   # se usar Azurite
#
# Sem RabbitMQ no momento: RABBITMQ_ENABLED=false

# ---------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------
# Compose (agent também em container): http://grafana:3000
# Local no host: http://127.0.0.1:3000
GRAFANA_URL=http://grafana:3000
GRAFANA_TOKEN=glsa_SEU_TOKEN_AQUI       # token da service account

# ---------------------------------------------------------------
# LLM — Provider genérico via LangChain
# ---------------------------------------------------------------

# Provider: anthropic | openai
LLM_PROVIDER=anthropic

# Modelo a ser usado (exemplos por provider)
#   anthropic : claude-sonnet-4-20250514, claude-3-haiku-20240307
#   openai    : gpt-4o, google/gemma-3-4b (LM Studio), etc.
LLM_MODEL=claude-sonnet-4-20250514

# Chave de API do provider (anthropic ou openai)
LLM_API_KEY=sk-SEU_TOKEN_AQUI

# URL base customizada — opcional
# Use para LM Studio (OpenAI-compat: termina em /v1), Azure OpenAI ou proxy compatível
# LM Studio na mesma VM: http://127.0.0.1:1234/v1
# LM Studio no Windows, agente no WSL (127.0.0.1 é só o Linux): use o IP do host, p.ex.
# o "nameserver" em /etc/resolv.conf ou o que LM Studio mostra — http://HOST:1234/v1
# Docker no host Windows: http://host.docker.internal:1234/v1
LLM_BASE_URL=

# Limite de caracteres do texto de contexto (métricas + logs) antes da chamada à LLM.
# Omita ou use 0 para não truncar (melhor para APIs cloud com contexto grande).
# LM Studio / llama.cpp com erro "n_keep ... >= n_ctx": use 2048–4096 OU aumente o
# context length do modelo em Settings → modelo (ex.: 8192).
# LLM_MAX_USER_PROMPT_CHARS=3072

# Prompt compacto (default): índice único de PromQL/LogQL; métricas sem repetir a query em cada bloco.
# false = formato antigo (query repetida sob cada métrica/categoria de log).
# LLM_PROMPT_COMPACT_QUERIES=true

# LLM_MAX_LOG_LINES_PER_CATEGORY=8
# LLM_MAX_LOG_LINE_CHARS=220

# CSV de chaves de label mostradas em «Labels (prioridade SRE)»; omitir o restante com contagem.
# LLM_LABEL_KEYS_ALLOWLIST=alertname,severity,namespace,service_name,job,...

# Limite de tokens de saída (API Anthropic/OpenAI). 0 = usar default do provider (sem teto explícito).
# Valores baixos podem truncar o relatório no meio.
# LLM_MAX_OUTPUT_TOKENS=0

# ---------------------------------------------------------------
# RabbitMQ (publicação em background após POST /webhook → 202)
# ---------------------------------------------------------------
# RABBITMQ_ENABLED=true
# Compose (agent em container): amqp://guest:guest@rabbitmq:5672/
# Agent no host + RabbitMQ no Compose: amqp://guest:guest@127.0.0.1:5672/
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# RABBITMQ_EXCHANGE=weather.agent
# RABBITMQ_ANALYSIS_QUEUE=weather.agent.analysis
# RABBITMQ_ANALYSIS_ROUTING_KEY=analysis
# RABBITMQ_RESOLVED_QUEUE=weather.agent.resolved
# RABBITMQ_RESOLVED_ROUTING_KEY=resolved

# ---------------------------------------------------------------
# Azure Blob — Azurite (emulador local, serviço blob na porta 10000)
# ---------------------------------------------------------------
# Grava markdown das análises LLM em container weather-agent (prefixo llm_results/).
# Sem BLOB_STORAGE, o upload é ignorado.
# DEBUG_LLM_RESULT=false

# URL com nome da conta no path (usa chave fixa devstoreaccount1 do Azurite):
# BLOB_STORAGE=http://127.0.0.1:10000/devstoreaccount1
# Agente no mesmo Compose que o Azurite:
# BLOB_STORAGE=http://azurite:10000/devstoreaccount1

# Alternativa — connection string (AccountKey pública do emulador):
# BLOB_STORAGE=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# ---------------------------------------------------------------
# Configurações opcionais
# ---------------------------------------------------------------
METRICS_LOOKBACK=900        # segundos (padrão: 15 min)
LOGS_LOOKBACK=15m           # formato: 5m, 1h, 2h
