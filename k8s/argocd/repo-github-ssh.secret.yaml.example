# =============================================================================
# Preferir: ./scripts/apply-argocd-ssh-secret.sh (não cola chave no YAML).
#
# Este ficheiro é só referência se quiser declarar o Secret à mão; ao colar a
# chave privada, indenta TODAS as linhas após "sshPrivateKey: |" (senão o YAML
# interpreta mal as linhas que começam com "---").
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: repo-weather-k8s-ssh
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: git@github.com:eduaguiar281/weather-k8s.git
  # Privada = ficheiro sem sufixo .pub (muitas linhas entre BEGIN e END).
  # Pública = uma linha "ssh-ed25519 AAAA..." (.pub) — NÃO cole isso aqui.
  sshPrivateKey: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    COLE_AQUI_O_CONTEÚDO_COMPLETO_DA_CHAVE_PRIVADA
    -----END OPENSSH PRIVATE KEY-----
