# =============================================================================
# COPIE para repo-github-ssh.secret.yaml, preencha a chave e NÃO commite a cópia.
#   cp k8s/argocd/repo-github-ssh.secret.yaml.example k8s/argocd/repo-github-ssh.secret.yaml
#
# A chave aqui é para o Argo CD (pods no cluster), não substitui seu ~/.ssh local.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: repo-weather-k8s-ssh
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: git@github.com:eduaguiar281/weather-k8s.git
  sshPrivateKey: |
    -----BEGIN OPENSSH PRIVATE KEY-----
    COLE_AQUI_O_CONTEÚDO_COMPLETO_DA_CHAVE_PRIVADA
    -----END OPENSSH PRIVATE KEY-----
