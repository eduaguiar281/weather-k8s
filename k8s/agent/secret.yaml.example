apiVersion: v1
kind: Secret
metadata:
  name: agent-secret
  namespace: weather-agent
type: Opaque
stringData:
  # Grafana só está na rede observability no Compose — sem IP na kind_bridge; pods no Kind usam a porta exposta no host:
  GRAFANA_URL: http://host.docker.internal:3000
  GRAFANA_TOKEN: glsa_SEU_TOKEN_AQUI        # token da service account do Grafana
  LLM_PROVIDER: anthropic                   # anthropic | openai
  LLM_MODEL: claude-sonnet-4-20250514       # modelo a usar
  LLM_API_KEY: sk-SEU_TOKEN_AQUI            # chave da API do provider
  # LM Studio: http://host.docker.internal:<porta>/v1  (LangChain já acrescenta /chat/completions; não usar /api/v1)
  LLM_BASE_URL: ""
  # AMQP também publicado no host (Compose 5672:5672):
  RABBITMQ_URL: amqp://guest:guest@host.docker.internal:5672/
  RABBITMQ_EXCHANGE: weather.agent
  RABBITMQ_ANALYSIS_QUEUE: weather.agent.analysis
  RABBITMQ_ANALYSIS_ROUTING_KEY: analysis
  RABBITMQ_RESOLVED_QUEUE: weather.agent.resolved
  RABBITMQ_RESOLVED_ROUTING_KEY: resolved
