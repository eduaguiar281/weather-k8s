{
  "uid": "weather-infra",
  "title": "Weather — Infra Kubernetes",
  "tags": ["weather", "infra", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "deployment",
        "type": "query",
        "label": "Deployment",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(kube_deployment_labels{namespace=~\"$namespace\"}, deployment)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Uso de CPU dos Pods (%)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "100 * sum by (namespace, pod) (label_replace(label_replace(rate(container_cpu_usage_seconds_total{container_label_io_kubernetes_pod_namespace=~\"$namespace\", container_label_io_kubernetes_pod_name=~\"$pod\", container_label_io_kubernetes_pod_name!=\"\", container_label_io_kubernetes_pod_namespace!=\"\"}[5m]), \"namespace\", \"$1\", \"container_label_io_kubernetes_pod_namespace\", \"(.*)\"), \"pod\", \"$1\", \"container_label_io_kubernetes_pod_name\", \"(.*)\")) / clamp_min((sum by (namespace, pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"cpu\", unit=\"core\"}) or sum by (namespace, pod) (kube_pod_container_resource_limits_cpu_cores{namespace=~\"$namespace\", pod=~\"$pod\"}) or sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"cpu\", unit=\"core\"}) or sum by (namespace, pod) (kube_pod_container_resource_requests_cpu_cores{namespace=~\"$namespace\", pod=~\"$pod\"})), 0.001)",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memória por Pod (Total x Utilizada)",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (namespace, pod) (label_replace(label_replace(container_memory_working_set_bytes{container_label_io_kubernetes_pod_namespace=~\"$namespace\", container_label_io_kubernetes_pod_name=~\"$pod\", container_label_io_kubernetes_pod_name!=\"\", container_label_io_kubernetes_pod_namespace!=\"\"}, \"namespace\", \"$1\", \"container_label_io_kubernetes_pod_namespace\", \"(.*)\"), \"pod\", \"$1\", \"container_label_io_kubernetes_pod_name\", \"(.*)\"))",
          "legendFormat": "{{namespace}}/{{pod}} - usada",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"memory\", unit=\"byte\"}) or sum by (namespace, pod) (kube_pod_container_resource_limits_memory_bytes{namespace=~\"$namespace\", pod=~\"$pod\"}) or sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=~\"$namespace\", pod=~\"$pod\", resource=\"memory\", unit=\"byte\"}) or sum by (namespace, pod) (kube_pod_container_resource_requests_memory_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{namespace}}/{{pod}} - total",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Histórico de Deploys no Período",
      "gridPos": { "x": 0, "y": 17, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (namespace, deployment) (changes(kube_deployment_status_observed_generation{namespace=~\"$namespace\", deployment=~\"$deployment\"}[$__interval]))",
          "legendFormat": "{{namespace}}/{{deployment}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Total de Deploys (Período)",
      "gridPos": { "x": 16, "y": 17, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(sum by (namespace, deployment) (changes(kube_deployment_status_observed_generation{namespace=~\"$namespace\", deployment=~\"$deployment\"}[$__range])))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Reinícios de Pods no Período",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__range])))",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evolução dos Reinícios (5m)",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
