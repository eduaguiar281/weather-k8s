{
  "uid": "weather-api-logs",
  "title": "Weather API — Logs",
  "tags": ["weather-api", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "log_source",
        "type": "custom",
        "label": "Fonte",
        "current": { "value": "app", "text": "Aplicação" },
        "options": [
          { "value": "app", "text": "Aplicação", "selected": true },
          { "value": "otel_sdk", "text": "OTel SDK", "selected": false },
          { "value": ".*", "text": "Todos", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Logs — weather-api  (fonte: $log_source)",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 20 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "{namespace=\"weather\", container=\"weather-api\", log_source=~\"$log_source\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Logs da Aplicação (última hora)",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum(count_over_time({namespace=\"weather\", container=\"weather-api\", log_source=\"app\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erros OTel SDK (última hora)",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "fixed",
        "fixedColor": "orange"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum(count_over_time({namespace=\"weather\", container=\"weather-api\", log_source=\"otel_sdk\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Volume por Fonte (logs/min)",
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 4 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
          "expr": "sum by (log_source) (rate({namespace=\"weather\", container=\"weather-api\"}[1m]))",
          "legendFormat": "{{log_source}}",
          "refId": "A"
        }
      ]
    }
  ]
}
